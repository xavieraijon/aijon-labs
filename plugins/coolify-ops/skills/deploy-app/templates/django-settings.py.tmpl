"""Production settings for Coolify, generated by deploy-app (coolify-ops).

Loads the project's own settings ({{SETTINGS_MODULE}}) and overrides only what a deployment behind Coolify's
HTTPS proxy needs, from environment variables set by deploy-app. The project's files are not changed.
Safe to edit; regenerate with prepare.py --overwrite.
"""

import importlib.util
import os
from pathlib import Path
from urllib.parse import unquote, urlsplit

from {{SETTINGS_MODULE}} import *  # noqa: F401,F403


def database_from_url(url):
    """DATABASE_URL → a DATABASES entry (None when unset). postgres:// (Coolify) or sqlite:////absolute/path."""
    if not url:
        return None
    u = urlsplit(url)
    if u.scheme in ("postgres", "postgresql"):
        return {"ENGINE": "django.db.backends.postgresql", "NAME": unquote(u.path.lstrip("/")),
                "USER": unquote(u.username or ""), "PASSWORD": unquote(u.password or ""),
                "HOST": u.hostname or "", "PORT": str(u.port or "")}
    if u.scheme == "sqlite":
        return {"ENGINE": "django.db.backends.sqlite3", "NAME": "/" + unquote(u.path).lstrip("/")}
    raise ValueError(f"DATABASE_URL: unsupported scheme {u.scheme!r} (use postgres:// or sqlite:////path)")


def with_whitenoise(middleware):
    """Insert WhiteNoise right after SecurityMiddleware (or first), once."""
    middleware = list(middleware)
    whitenoise, security = "whitenoise.middleware.WhiteNoiseMiddleware", "django.middleware.security.SecurityMiddleware"
    if whitenoise in middleware:
        return middleware
    at = middleware.index(security) + 1 if security in middleware else 0
    return middleware[:at] + [whitenoise] + middleware[at:]


SECRET_KEY = os.environ["DJANGO_SECRET_KEY"]  # generated by deploy-app; never the key committed in the project
DEBUG = os.environ.get("DJANGO_DEBUG") == "1"
ALLOWED_HOSTS = [h for h in os.environ.get("DJANGO_ALLOWED_HOSTS", "").split(",") if h] + ["localhost", "127.0.0.1"]
SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")  # Coolify's Traefik replaces client-sent X-Forwarded-*
SECURE_SSL_REDIRECT = False  # Traefik already redirects HTTP to HTTPS; health and local checks use plain HTTP
SESSION_COOKIE_SECURE = CSRF_COOKIE_SECURE = os.environ.get("DJANGO_INSECURE_COOKIES") != "1"

_database = database_from_url(os.environ.get("DATABASE_URL"))
if _database:  # unset (e.g. collectstatic at build time): the project's DATABASES stay
    DATABASES = {**globals().get("DATABASES", {}), "default": _database}

if not globals().get("STATIC_ROOT"):
    STATIC_ROOT = str(Path(__file__).resolve().parent / "staticfiles")
if "django.contrib.staticfiles" in globals().get("INSTALLED_APPS", ()) and importlib.util.find_spec("whitenoise"):
    MIDDLEWARE = with_whitenoise(globals().get("MIDDLEWARE", []))

if not globals().get("LOGGING"):  # errors and requests in the container logs (Django's default hides them)
    LOGGING = {"version": 1, "disable_existing_loggers": False,
               "handlers": {"console": {"class": "logging.StreamHandler"}},
               "loggers": {"django": {"handlers": ["console"], "level": "INFO"}}}
